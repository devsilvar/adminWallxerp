# =================================
# Frontend env vars (Vite)
# =================================
# Only variables prefixed VITE_ are exposed to client-side code.
# Set these in your deploy host's dashboard (Vercel / Netlify), NOT in git.

# API base URL.
#   Dev: leave UNSET — falls back to '/api/v1' which Vite proxies to
#        the local backend (see vite.config.ts).
#   Prod: full URL including /api/v1 path prefix.
#   Live Render: https://paymy-tax.onrender.com/api/v1
#   Examples:
#     VITE_API_BASE_URL=https://paymy-tax.onrender.com/api/v1
#     VITE_API_BASE_URL=https://paymytax-api.up.railway.app/api/v1
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Test Simulator Tool (Dev / Staging testing only)
# Set to 'true' to activate the /test/transfer-simulator route.
# Keep unset or 'false' for production security hygiene.
VITE_ENABLE_TRANSFER_SIMULATOR=false

# Maintenance Mode (Emergency downtime communication)
# Set to 'true' to display a maintenance screen to all visitors.
# When enabled, all users see a professional holding page instead of the app.
# Toggle this in your hosting dashboard (Railway, Vercel, Netlify) to instantly
# activate/deactivate without redeploying code.
# Default: 'false' (app operational)
VITE_MAINTENANCE_MODE=false

# Tax Remittance (Pay) — gated until the NRS payment integration is granted.
# While unset/'false', finalized reports show a "Remittance coming soon" chip
# instead of the Pay button. Flip to 'true' to restore the Paystack flow.
VITE_ENABLE_TAX_PAYMENTS=false

# Admin Portal URL (for redirects and session switcher)
#   Dev: http://localhost:5174
#   Prod: https://admin.wallx.ng or https://admin.paymytax.ng
VITE_ADMIN_URL=http://localhost:5174

# Session lifetime — client-side inactivity + absolute timeout
# (single-tab clocks survive hard reloads; cross-tab sync via storage event)
# Idle:   minutes with no mousemove/keydown/click/scroll/touch before force logout
# Absolute: hours since login before force logout regardless of activity
# Defaults: 30m idle / 12h absolute. Minimums: 5m / 1h.
# VITE_SESSION_IDLE_MINUTES=30
# VITE_SESSION_ABSOLUTE_HOURS=12
