# =================================
# Dependencies
# =================================
node_modules/
**/node_modules/

# =================================
# Build output
# =================================
dist/
**/dist/
build/
**/build/
*.tsbuildinfo

# =================================
# Logs
# =================================
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =================================
# Environment variables — NEVER commit secrets
# =================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
.env.*
!.env.example
.env.development.local
.env.production.local
.env.test.local
*.bak
.vercel/

# =================================
# Backups, dumps, seed artifacts — never commit
# DB dumps contain user emails, password hashes, phone numbers, PIN hashes
# =================================
backups/
dump*.json
db-dump*.json
seed-output*.json
seed-*.json
*-seed.json
*.dump
.sql.gz
# Credentials
credentials*.json
service-account*.json
*.pem
*.key
.p12
*.pfx

# Embedded repos have their own .gitignore; these are the backstop for the
# parent repo, which also tracks backend/ frontend/ marketplaceFrontend/ etc.
backend/.env*
!backend/.env.example
frontend/.env*
!frontend/.env.example
marketplaceFrontend/.env*
!marketplaceFrontend/.env.example
adminFrontend/.env*
!adminFrontend/.env.example
backend/backups/

# =================================
# OS / Editor files
# =================================
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# =================================
# Editor directories and files
# =================================
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.njsproj
*.sln
*.ntvs*
*.sw?

# Documentation & notes (keep plan docs tracked)
!*.md
!*.txt
# Scratch workspace
scratch/

# The Wowo external API is its own repository and is checked out here only for
# local convenience. It must never be tracked by this repo — see docs/
# external-api-service-plan.reviewed.md §4.1.
external-api/
