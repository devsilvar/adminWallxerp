# =================================
# Admin Frontend env vars (Vite)
# =================================
# Only variables prefixed VITE_ are exposed to client-side code.
# Port: 5174 (dev) / admin.wallx.ng (prod)

# API base URL.
#   Dev: leave UNSET — falls back to '/api/v1' which Vite proxies to http://localhost:3000
#   Prod: full URL including /api/v1 path prefix.
#   Live Render: https://paymy-tax.onrender.com/api/v1
# VITE_API_BASE_URL=https://paymy-tax.onrender.com/api/v1

# SME Portal URL (for session switcher to user application)
#   Dev: http://localhost:5173
#   Prod: https://app.wallx.ng or https://app.paymytax.ng
VITE_SME_URL=http://localhost:5173
