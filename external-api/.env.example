# Our own database. Never the SME app's — see plan §5.5 / §14.
# Runtime connection. On Supabase this is the pooler.
DATABASE_URL="postgresql://user:password@localhost:5432/wowo_external?schema=public"

# Used by `prisma migrate` only, which takes advisory locks a transaction-mode
# pooler cannot hold. Leave unset outside local development.
# A password containing '@' must be percent-encoded as %40.
DIRECT_URL="postgresql://user:password@localhost:5432/wowo_external?schema=public"

NODE_ENV=development
PORT=3000

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Railway terminates TLS; keep at 1 unless the proxy chain changes.
TRUST_PROXY=1

# false -> 503 on API routes, /health stays 200 (D16, layer 1)
EXTERNAL_API_ENABLED=true

# In-memory rate buckets are divided by this (D43). Must match real replica count.
INSTANCE_COUNT=1
EXTERNAL_DATA_RATE_LIMIT=120
EXTERNAL_ACTIVATION_RATE_LIMIT=10
EXTERNAL_PUBLIC_PDF_RATE_LIMIT=30

EXTERNAL_ROTATE_GRACE_MINUTES=10
EXTERNAL_CODE_TTL_HOURS=72
EXTERNAL_SHARE_TOKEN_TTL_DAYS=30
EXTERNAL_TOMBSTONE_RETENTION_DAYS=180
EXTERNAL_AUDIT_RETENTION_DAYS=730

PLATFORM_FLAT_FEE_NGN=0
