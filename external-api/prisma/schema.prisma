// Wowo external API — our own database, our own migration history.
// Nothing here is shared with the SME app at runtime (D25, D27).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations take advisory locks, which a transaction-mode pooler (port 6543)
  // cannot hold. Locally both point at the Supabase session pooler; on Railway
  // this is unset and `url` is used.
  directUrl = env("DIRECT_URL")
}

