---
import Layout from '@/layouts/Layout.astro';
import { PackageX, Home, Search, ArrowRight } from 'lucide-react';

export const prerender = true;
---

<Layout
  title="Page Not Found — WallX Marketplace"
  description="The page or listing you are looking for could not be found."
>
  <main class="min-h-[70vh] flex items-center justify-center py-16 px-5 sm:px-8 bg-gray-50/50">
    <div class="max-w-md w-full text-center">
      <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-3xl bg-purple-50 text-[#352778] shadow-sm">
        <PackageX className="h-10 w-10 text-[#352778]" client:load />
      </div>

      <span class="inline-block rounded-full bg-purple-100/70 px-3.5 py-1 text-[12px] font-bold text-[#352778] mb-3">
        404 Error
      </span>

      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
        Page not found
      </h1>

      <p class="mt-3 text-[14px] leading-relaxed text-gray-500">
        Sorry, we couldn’t find the page or listing you were looking for. The link may be broken, or the listing may have expired.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/products"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full bg-[#352778] px-6 py-3 text-[13.5px] font-bold text-white shadow-sm hover:bg-[#2a1f5e] transition-colors"
        >
          <Search className="h-4 w-4" client:load />
          Explore Listings
        </a>

        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-white px-6 py-3 text-[13.5px] font-semibold text-gray-700 hover:border-gray-300 hover:bg-gray-50 transition-colors"
        >
          <Home className="h-4 w-4" client:load />
          Return Home
        </a>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-200">
        <p class="text-[12.5px] text-gray-400">
          Looking to list your own products or services?
          <a href="/products" class="font-semibold text-[#352778] hover:underline inline-flex items-center gap-1 ml-1">
            Sell on WallX <ArrowRight className="h-3 w-3 inline" client:load />
          </a>
        </p>
      </div>
    </div>
  </main>
</Layout>
