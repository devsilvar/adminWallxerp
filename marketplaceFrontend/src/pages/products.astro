---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard';
import { getProducts } from '@/lib/api';
import { MARKETPLACE_CATEGORIES, CATEGORY_LABELS, type Product, type PaginationMeta, type MarketplaceFacets } from '@/types';
import { Search, X, ChevronLeft, ChevronRight, PackageOpen, SlidersHorizontal, MapPin, AlertCircle, RefreshCw, ArrowRight } from 'lucide-react';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');

const url = new URL(Astro.request.url);
const search = url.searchParams.get('search') || undefined;
const category = url.searchParams.get('category') || undefined;
const type = url.searchParams.get('type') || undefined;
const stateFilter = url.searchParams.get('state') || undefined;
const sort = url.searchParams.get('sort') || 'newest';
const minPriceParam = url.searchParams.get('minPrice');
const minPriceParsed = minPriceParam ? Number(minPriceParam) : undefined;
const minPrice = Number.isFinite(minPriceParsed) ? minPriceParsed : undefined;
const maxPriceParam = url.searchParams.get('maxPrice');
const maxPriceParsed = maxPriceParam ? Number(maxPriceParam) : undefined;
const maxPrice = Number.isFinite(maxPriceParsed) ? maxPriceParsed : undefined;
const verifiedOnly = url.searchParams.get('verifiedOnly') === 'true' ? true : undefined;
const hasDiscount = url.searchParams.get('hasDiscount') === 'true' ? true : undefined;
const inStockOnly = url.searchParams.get('inStockOnly') === 'true' ? true : undefined;
const page = Math.max(Number(url.searchParams.get('page')) || 1, 1);
const limit = 16;

let displayProducts: Product[] = [];
let pagination: PaginationMeta = { page: 1, limit: 16, total: 0, totalPages: 1 };
let facets: MarketplaceFacets | undefined = undefined;
let isUnavailable = false;

try {
  const response = await getProducts({
    search,
    category,
    type,
    state: stateFilter,
    sort,
    minPrice,
    maxPrice,
    verifiedOnly,
    hasDiscount,
    inStockOnly,
    page,
    limit,
  });
  displayProducts = response.data || [];
  pagination = response.pagination || { page: 1, limit: 16, total: displayProducts.length, totalPages: 1 };
  facets = response.facets;
} catch (error) {
  console.error('[products.astro] Failed to load marketplace products:', error);
  Astro.response.status = 503;
  isUnavailable = true;
}

function buildFilterUrl(params: Record<string, string | number | undefined | null>): string {
  const p = new URLSearchParams(url.searchParams);
  Object.entries(params).forEach(([k, v]) => {
    if (v === undefined || v === null || v === '') p.delete(k);
    else p.set(k, String(v));
  });
  const qs = p.toString();
  return `/products${qs ? `?${qs}` : ''}`;
}

const activeCategoryLabel = category
  ? CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS] || category
  : null;

// Nigerian states for Jiji-style location filter
const NG_STATES = [
  'Abia','Adamawa','Akwa Ibom','Anambra','Bauchi','Bayelsa','Benue','Borno',
  'Cross River','Delta','Ebonyi','Edo','Ekiti','Enugu','FCT – Abuja','Gombe',
  'Imo','Jigawa','Kaduna','Kano','Katsina','Kebbi','Kogi','Kwara','Lagos',
  'Nasarawa','Niger','Ogun','Ondo','Osun','Oyo','Plateau','Rivers','Sokoto',
  'Taraba','Yobe','Zamfara'
];

// Phase 6: Dynamic empty state messaging & smart alternative recommendations
let emptyTitle = 'No matching products found';
let emptyDescription = 'Try adjusting your search keywords or filters.';

if (category && stateFilter) {
  emptyTitle = `No ${activeCategoryLabel} in ${stateFilter}`;
  emptyDescription = `We couldn't find any ${activeCategoryLabel?.toLowerCase()} listings in ${stateFilter} right now.`;
} else if (category && search) {
  emptyTitle = `No ${activeCategoryLabel} matching "${search}"`;
  emptyDescription = `We found no ${activeCategoryLabel?.toLowerCase()} matching your search keywords.`;
} else if (stateFilter && search) {
  emptyTitle = `No results for "${search}" in ${stateFilter}`;
  emptyDescription = `Try broadening your search or searching across all states.`;
} else if (category) {
  emptyTitle = `No ${activeCategoryLabel} listings currently available`;
  emptyDescription = `Check back soon or explore other popular categories across Nigeria.`;
} else if (stateFilter) {
  emptyTitle = `No listings in ${stateFilter} right now`;
  emptyDescription = `There are currently no approved listings located in ${stateFilter}.`;
} else if (search) {
  emptyTitle = `No results found for "${search}"`;
  emptyDescription = `Check your spelling or try searching with more general terms.`;
}

interface EmptyAlternative {
  label: string;
  url: string;
  count: number;
}

const emptyAlternatives: EmptyAlternative[] = [];

if (facets) {
  // Facet counts are computed over category+type+search base and ignore state/price/verified/discount/stock filters.
  // Clear those ignored filters in facet-derived alternatives so links return results consistent with the counts.
  const facetBaseReset = {
    page: 1,
    minPrice: undefined,
    maxPrice: undefined,
    verifiedOnly: undefined,
    hasDiscount: undefined,
    inStockOnly: undefined,
  };

  // Scenario 1: Specific Category + State combination is empty
  if (category && stateFilter) {
    // 1. Same category across all Nigeria (if count > 0)
    const catTotal = facets.categories?.find((c) => c.slug === category)?.count;
    if (catTotal && catTotal > 0) {
      emptyAlternatives.push({
        label: `${catTotal} ${activeCategoryLabel} ${catTotal === 1 ? 'listing' : 'listings'} elsewhere in Nigeria`,
        url: buildFilterUrl({ state: undefined, ...facetBaseReset }),
        count: catTotal,
      });
    }

    // 2. Same state in other categories (facet state count is within current category base; removing category broadens results)
    const stateItem = facets.states?.find((s) => s.name.toLowerCase() === stateFilter.toLowerCase());
    if (stateItem && stateItem.count > 0) {
      emptyAlternatives.push({
        label: `Listings in ${stateFilter} in other categories`,
        url: buildFilterUrl({ category: undefined, ...facetBaseReset }),
        count: stateItem.count,
      });
    }
  }

  // Suggest top non-empty categories if we need more alternatives
  if (emptyAlternatives.length < 2 && facets.categories?.length) {
    const candidateCats = facets.categories
      .filter((c) => c.slug !== category && c.count > 0)
      .slice(0, 2 - emptyAlternatives.length);

    for (const c of candidateCats) {
      const catLabel = CATEGORY_LABELS[c.slug as keyof typeof CATEGORY_LABELS] || c.slug;
      emptyAlternatives.push({
        label: `${c.count} ${catLabel} ${c.count === 1 ? 'listing' : 'listings'}`,
        url: buildFilterUrl({ category: c.slug, state: undefined, search: undefined, ...facetBaseReset }),
        count: c.count,
      });
    }
  }

  // Suggest top non-empty states if we still have fewer than 2 alternatives
  if (emptyAlternatives.length < 2 && facets.states?.length) {
    const candidateStates = facets.states
      .filter((s) => s.name.toLowerCase() !== (stateFilter || '').toLowerCase() && s.count > 0)
      .slice(0, 2 - emptyAlternatives.length);

    for (const s of candidateStates) {
      emptyAlternatives.push({
        label: `${s.count} ${s.count === 1 ? 'listing' : 'listings'} in ${s.name}`,
        url: buildFilterUrl({ state: s.name, category: undefined, search: undefined, ...facetBaseReset }),
        count: s.count,
      });
    }
  }
}
---

<Layout
  title={`${activeCategoryLabel ? `${activeCategoryLabel} — ` : ''}${search ? `"${search}" — ` : ''}WallX Marketplace`}
  description="Discover quality products and services offered directly by verified Nigerian SMEs."
>

  {isUnavailable ? (
    <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-20 text-center">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
        <AlertCircle className="h-8 w-8" client:load />
      </div>
      <h1 class="text-2xl font-extrabold text-gray-900">Marketplace Temporarily Unavailable</h1>
      <p class="mt-2 text-[14px] text-gray-500 max-w-md mx-auto">
        We're currently unable to load live listings. Our systems are reconnecting, please try again in a few moments.
      </p>
      <div class="mt-7 flex items-center justify-center gap-3">
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center gap-2 rounded-full bg-[#352778] px-6 py-2.5 text-[13px] font-bold text-white hover:bg-[#2a1f5e] transition-colors"
        >
          <RefreshCw className="h-4 w-4" client:load />
          Retry Now
        </button>
        <a
          href="/"
          class="inline-flex items-center rounded-full border border-gray-200 px-6 py-2.5 text-[13px] font-semibold text-gray-700 hover:border-gray-300 hover:bg-gray-50 transition-colors"
        >
          Return Home
        </a>
      </div>
    </div>
  ) : (
    <div>
      <div class="border-b border-gray-200 bg-gray-50/80">
        <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-9">
          <h1 class="text-2xl sm:text-[1.75rem] font-extrabold tracking-tight text-gray-900">
            {activeCategoryLabel ? activeCategoryLabel : 'All Products & Services'}
          </h1>
          <p class="mt-1 text-[13px] text-gray-400">
            {pagination.total} approved {pagination.total === 1 ? 'listing' : 'listings'} across Nigeria
          </p>

          <form method="GET" action="/products" class="mt-5 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center max-w-[640px]">
            {category && <input type="hidden" name="category" value={category} />}
            {type && <input type="hidden" name="type" value={type} />}

            <div class="flex flex-1 items-center rounded-full border-2 border-[#352778] bg-white overflow-hidden">
              <Search className="ml-5 h-4 w-4 text-gray-400" client:load />
              <input
                type="search"
                name="search"
                value={search || ''}
                placeholder="What are you looking for?"
                class="w-full bg-transparent pl-3 pr-4 py-2.5 text-[13.5px] text-gray-900 placeholder:text-gray-400 focus:outline-none"
              />
              <button type="submit" class="shrink-0 bg-[#352778] px-6 py-2.5 text-[13px] font-bold text-white hover:bg-[#2a1f5e] transition-colors">
                Search
              </button>
            </div>
            {(search || category || type || stateFilter) && (
              <a href="/products" class="self-start sm:self-auto">
                <button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-4 py-2.5 text-[13px] font-medium text-gray-600 hover:border-gray-300 hover:text-gray-900 transition-colors">
                  <X className="h-3.5 w-3.5" client:load /> Clear
                </button>
              </a>
            )}
          </form>
        </div>
      </div>

      <div class="border-b border-gray-100 bg-white sticky top-[64px] z-30 shadow-[0_1px_0_0_rgba(0,0,0,0.04)]">
        <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-3 flex items-center gap-3 overflow-x-auto scrollbar-none">
          <MapPin className="h-4 w-4 text-[#7c3aed] shrink-0" client:load />
          <span class="text-[12px] font-bold text-gray-500 shrink-0">State:</span>

          <a
            href={buildFilterUrl({ state: undefined, page: 1 })}
            class={`shrink-0 inline-flex items-center rounded-full px-3.5 py-1.5 text-[12px] font-bold border transition-colors ${
              !stateFilter
                ? 'bg-[#352778] text-white border-[#352778]'
                : 'bg-white text-gray-600 border-gray-200 hover:border-[#7c3aed] hover:text-[#352778]'
            }`}
          >
            All Nigeria
          </a>

          {['Lagos','Abuja','Rivers','Kano','Oyo','Delta','Anambra','Edo','Ogun','Kaduna'].map((st) => (
            <a
              href={buildFilterUrl({ state: st, page: 1 })}
              class={`shrink-0 inline-flex items-center rounded-full px-3.5 py-1.5 text-[12px] font-semibold border transition-colors ${
                stateFilter === st
                  ? 'bg-[#352778] text-white border-[#352778]'
                  : 'bg-white text-gray-600 border-gray-200 hover:border-[#7c3aed] hover:text-[#352778]'
              }`}
            >
              {st}
            </a>
          ))}

          <span class="text-gray-200 shrink-0">|</span>
          <form method="GET" action="/products" class="shrink-0">
            {search && <input type="hidden" name="search" value={search} />}
            {category && <input type="hidden" name="category" value={category} />}
            {type && <input type="hidden" name="type" value={type} />}
            <select
              name="state"
              onchange="this.form.submit()"
              class="rounded-full border border-gray-200 bg-white px-3 py-1.5 text-[12px] font-semibold text-gray-600 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/20 focus:border-[#7c3aed] cursor-pointer"
            >
              <option value="">More states...</option>
              {NG_STATES.map((st) => (
                <option value={st} selected={stateFilter === st}>{st}</option>
              ))}
            </select>
          </form>
        </div>
      </div>

      <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-8">
        <div class="flex flex-col lg:flex-row gap-7">

          <aside class="w-full lg:w-52 xl:w-56 shrink-0">
            <div class="sticky top-[72px] rounded-2xl border border-gray-200 bg-white p-5 shadow-[0_1px_4px_0_rgba(0,0,0,0.05)]">

              <div class="mb-5">
                <div class="flex items-center gap-2 text-[10.5px] font-bold uppercase tracking-widest text-gray-400 mb-2.5">
                  <SlidersHorizontal className="h-3.5 w-3.5" client:load />
                  <span>Categories</span>
                </div>
                <ul class="space-y-0.5">
                  <li>
                    <a
                      href={buildFilterUrl({ category: undefined, page: 1 })}
                      class={`flex items-center justify-between rounded-xl px-3 py-2 text-[13px] font-medium transition-colors ${
                        !category
                          ? 'bg-purple-50 text-[#352778] font-bold border-l-[3px] border-[#352778] pl-[9px]'
                          : 'text-gray-500 hover:bg-gray-50 hover:text-gray-800'
                      }`}
                    >
                      All Categories
                    </a>
                  </li>
                  {MARKETPLACE_CATEGORIES.map((cat) => {
                    const catCount = facets?.categories?.find((c) => c.slug === cat)?.count;
                    return (
                      <li>
                        <a
                          href={buildFilterUrl({ category: cat, page: 1 })}
                          class={`flex items-center justify-between rounded-xl px-3 py-2 text-[13px] font-medium transition-colors ${
                            category === cat
                              ? 'bg-purple-50 text-[#352778] font-bold border-l-[3px] border-[#352778] pl-[9px]'
                              : 'text-gray-500 hover:bg-gray-50 hover:text-gray-800'
                          }`}
                        >
                          <span>{CATEGORY_LABELS[cat]}</span>
                          {catCount !== undefined && (
                            <span class="text-[11px] font-semibold text-gray-400 bg-gray-100 rounded-full px-2 py-0.5">
                              {catCount}
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>

              <div class="border-t border-gray-100 pt-4">
                <div class="text-[10.5px] font-bold uppercase tracking-widest text-gray-400 mb-2.5">Listing Type</div>
                <div class="flex flex-wrap gap-1.5">
                  {[
                    { label: 'All', value: undefined },
                    { label: 'Physical', value: 'physical' },
                    { label: 'Services', value: 'service' },
                  ].map(({ label, value }) => (
                    <a
                      href={buildFilterUrl({ type: value, page: 1 })}
                      class={`rounded-full px-3 py-1 text-[11.5px] font-bold border transition-colors ${
                        type === value || (!type && !value)
                          ? 'bg-[#352778] text-white border-transparent'
                          : 'border-gray-200 text-gray-500 hover:border-[#352778] hover:text-[#352778]'
                      }`}
                    >
                      {label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </aside>

          <main class="flex-1 min-w-0">

            {(search || category || type || stateFilter) && (
              <div class="mb-5 flex flex-wrap items-center gap-2">
                <span class="text-[11.5px] text-gray-400 font-medium">Filtered by:</span>
                {category && (
                  <a href={buildFilterUrl({ category: undefined, page: 1 })} class="inline-flex items-center gap-1 rounded-full bg-purple-50 border border-purple-200 px-3 py-0.5 text-[11.5px] font-bold text-[#352778] hover:bg-purple-100">
                    {activeCategoryLabel} <X className="h-3 w-3" client:load />
                  </a>
                )}
                {search && (
                  <a href={buildFilterUrl({ search: undefined, page: 1 })} class="inline-flex items-center gap-1 rounded-full bg-purple-50 border border-purple-200 px-3 py-0.5 text-[11.5px] font-bold text-[#352778] hover:bg-purple-100">
                    "{search}" <X className="h-3 w-3" client:load />
                  </a>
                )}
                {type && (
                  <a href={buildFilterUrl({ type: undefined, page: 1 })} class="inline-flex items-center gap-1 rounded-full bg-purple-50 border border-purple-200 px-3 py-0.5 text-[11.5px] font-bold text-[#352778] hover:bg-purple-100">
                    {type} <X className="h-3 w-3" client:load />
                  </a>
                )}
                {stateFilter && (
                  <a href={buildFilterUrl({ state: undefined, page: 1 })} class="inline-flex items-center gap-1 rounded-full bg-purple-50 border border-purple-200 px-3 py-0.5 text-[11.5px] font-bold text-[#352778] hover:bg-purple-100">
                    State: {stateFilter} <X className="h-3 w-3" client:load />
                  </a>
                )}
                <a href="/products" class="text-[11.5px] text-gray-400 underline hover:text-[#352778] ml-1">
                  Reset all
                </a>
              </div>
            )}

            <div class="flex items-center justify-between mb-5 pb-3 border-b border-gray-100">
              <span class="text-[13px] font-medium text-gray-500">
                Showing <strong class="text-gray-900 font-bold">{displayProducts.length}</strong> of <strong class="text-gray-900 font-bold">{pagination.total}</strong> {pagination.total === 1 ? 'item' : 'items'}
              </span>
              <div class="flex items-center gap-2">
                <label for="sort-select" class="text-[12px] font-medium text-gray-400 hidden sm:inline">Sort by:</label>
                <select
                  id="sort-select"
                  onchange="window.location.href = this.value"
                  class="rounded-full border border-gray-200 bg-white px-3 py-1 text-[12px] font-semibold text-gray-700 focus:outline-none focus:ring-1 focus:ring-[#7c3aed] cursor-pointer"
                >
                  <option value={buildFilterUrl({ sort: 'newest', page: 1 })} selected={sort === 'newest'}>Newest First</option>
                  <option value={buildFilterUrl({ sort: 'price-asc', page: 1 })} selected={sort === 'price-asc' || sort === 'price_asc'}>Price: Low to High</option>
                  <option value={buildFilterUrl({ sort: 'price-desc', page: 1 })} selected={sort === 'price-desc' || sort === 'price_desc'}>Price: High to Low</option>
                  <option value={buildFilterUrl({ sort: 'relevance', page: 1 })} selected={sort === 'relevance'}>Relevance</option>
                </select>
              </div>
            </div>

            {displayProducts.length > 0 ? (
              <div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                  {displayProducts.map((product) => (
                    <ProductCard product={product} client:load />
                  ))}
                </div>

                {pagination.totalPages > 1 && (
                  <div class="mt-12 flex items-center justify-center gap-3">
                    {pagination.page > 1 ? (
                      <a href={buildFilterUrl({ page: pagination.page - 1 })}>
                        <button class="inline-flex items-center gap-1.5 rounded-full border-2 border-gray-200 px-4 py-2 text-[13px] font-bold text-gray-600 hover:border-[#352778] hover:text-[#352778] transition-all">
                          <ChevronLeft className="h-4 w-4" client:load /> Prev
                        </button>
                      </a>
                    ) : (
                      <button disabled class="inline-flex items-center gap-1.5 rounded-full border-2 border-gray-100 px-4 py-2 text-[13px] font-bold text-gray-300 cursor-not-allowed">
                        <ChevronLeft className="h-4 w-4" client:load /> Prev
                      </button>
                    )}

                    <span class="rounded-full bg-[#352778] text-white px-5 py-2 text-[13px] font-bold">
                      {pagination.page} / {pagination.totalPages}
                    </span>

                    {pagination.page < pagination.totalPages ? (
                      <a href={buildFilterUrl({ page: pagination.page + 1 })}>
                        <button class="inline-flex items-center gap-1.5 rounded-full border-2 border-gray-200 px-4 py-2 text-[13px] font-bold text-gray-600 hover:border-[#352778] hover:text-[#352778] transition-all">
                          Next <ChevronRight className="h-4 w-4" client:load />
                        </button>
                      </a>
                    ) : (
                      <button disabled class="inline-flex items-center gap-1.5 rounded-full border-2 border-gray-100 px-4 py-2 text-[13px] font-bold text-gray-300 cursor-not-allowed">
                        Next <ChevronRight className="h-4 w-4" client:load />
                      </button>
                    )}
                  </div>
                )}
              </div>
            ) : (
              <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50/70 p-8 sm:p-12 text-center max-w-xl mx-auto my-6">
                <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-purple-100/80 text-[#352778]">
                  <PackageOpen className="h-7 w-7 text-[#7c3aed]" client:load />
                </div>
                <h3 class="text-lg font-bold text-gray-900 tracking-tight">
                  {emptyTitle}
                </h3>
                <p class="mt-2 text-[13.5px] text-gray-500 max-w-sm mx-auto">
                  {emptyDescription}
                </p>

                {emptyAlternatives.length > 0 && (
                  <div class="mt-6 pt-6 border-t border-gray-200/60">
                    <p class="text-[11.5px] font-bold text-gray-400 uppercase tracking-wider mb-3">
                      Suggested Alternatives
                    </p>
                    <div class="flex flex-col sm:flex-row gap-2.5 justify-center items-center">
                      {emptyAlternatives.map((alt) => (
                        <a
                          href={alt.url}
                          class="inline-flex items-center justify-center gap-1.5 rounded-full bg-white border border-purple-200 px-4 py-2 text-[12.5px] font-bold text-[#352778] shadow-sm hover:border-[#352778] hover:bg-purple-50 transition-all"
                        >
                          <span>{alt.label}</span>
                          <ArrowRight className="h-3.5 w-3.5 text-[#7c3aed]" client:load />
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <div class="mt-6">
                  <a
                    href="/products"
                    class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-gray-500 hover:text-[#352778] transition-colors underline"
                  >
                    Reset all filters
                  </a>
                </div>
              </div>
            )}
          </main>
        </div>
      </div>
    </div>
  )}

</Layout>
