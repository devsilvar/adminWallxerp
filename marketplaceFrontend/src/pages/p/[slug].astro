---
import Layout from '@/layouts/Layout.astro';
import ProductGallery from '@/components/ProductGallery';
import ProductCard from '@/components/ProductCard';
import MobileStickyContact from '@/components/MobileStickyContact';
import { getProductBySlug, getWhatsAppRedirectUrl, API_BASE_URL } from '@/lib/api';
import { CATEGORY_LABELS, type Product, type RelatedProduct } from '@/types';
import { BadgeCheck, MapPin, MessageCircle, Phone, ExternalLink, ShieldCheck, ChevronRight, Share2, PackageX, AlertCircle, RefreshCw, ArrowRight } from 'lucide-react';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=600');

const { slug } = Astro.params;

let product: Product | null = null;
let relatedProducts: RelatedProduct[] = [];
let isUnavailable = false;

if (!slug) {
  Astro.response.status = 404;
} else {
  try {
    const detail = await getProductBySlug(slug);
    if (!detail || !detail.product) {
      Astro.response.status = 404;
    } else {
      product = detail.product;
      relatedProducts = detail.relatedProducts || [];
    }
  } catch (error) {
    console.error(`[p/[slug].astro] Failed to fetch product for slug "${slug}":`, error);
    Astro.response.status = 503;
    isUnavailable = true;
  }
}

// Compute derived display values only when product is found
const categoryLabel = product
  ? CATEGORY_LABELS[product.category as keyof typeof CATEGORY_LABELS] || product.category || 'General'
  : 'General';

const formattedPrice = product
  ? '\u20a6' + Number(product.price).toLocaleString()
  : '';

const formattedCompareAtPrice = product?.compareAtPrice
  ? '\u20a6' + Number(product.compareAtPrice).toLocaleString()
  : null;

const hasDiscount = Boolean(product && product.compareAtPrice && product.compareAtPrice > product.price);
const discountPercent = hasDiscount && product && product.compareAtPrice
  ? Math.round(((product.compareAtPrice - product.price) / product.compareAtPrice) * 100)
  : 0;

const isOutOfStock = Boolean(
  product &&
  product.trackInventory &&
  product.stockQuantity !== null &&
  product.stockQuantity !== undefined &&
  product.stockQuantity <= 0
);

const isLowStock = Boolean(
  product &&
  product.trackInventory &&
  product.stockQuantity !== null &&
  product.stockQuantity !== undefined &&
  product.stockQuantity > 0 &&
  product.stockQuantity <= 3
);

const rawPhone = product?.contactWhatsapp || product?.contactPhone || '';
const cleanPhone = rawPhone.replace(/[^0-9+]/g, '').replace(/^0/, '+234');
const hasContact = Boolean(cleanPhone && cleanPhone.replace('+', '').trim().length >= 7);
const whatsappUrl = product && hasContact
  ? getWhatsAppRedirectUrl(product.id, 'detail_page')
  : null;
const mobileStickyWhatsappUrl = product && hasContact
  ? getWhatsAppRedirectUrl(product.id, 'mobile_sticky')
  : null;
const telUrl = cleanPhone ? 'tel:' + cleanPhone : null;

const sellerIdentifier = product?.seller?.merchantId || product?.seller?.id;
const storefrontUrl = sellerIdentifier ? `/s/${sellerIdentifier}` : null;

function formatAttributeKey(key: string): string {
  return key.replace(/([A-Z])/g, ' $1').replace(/^./, (s) => s.toUpperCase()).trim();
}

function formatAttributeValue(val: unknown): string {
  if (typeof val === 'boolean') return val ? 'Yes' : 'No';
  if (Array.isArray(val)) return val.join(', ');
  return String(val);
}

const sellerInitial = (product?.seller?.businessName || 'M').charAt(0).toUpperCase();

const pageTitle = isUnavailable
  ? 'Service Temporarily Unavailable — WallX Marketplace'
  : product
  ? `${product.name} | WallX Marketplace`
  : 'Listing Not Found — WallX Marketplace';

const pageDescription = isUnavailable
  ? 'We are experiencing connectivity issues retrieving this product. Please try again shortly.'
  : product
  ? (product.description?.slice(0, 160) || `Buy ${product.name} directly from verified merchants in Nigeria.`)
  : 'The requested listing could not be found or may have been removed.';
---

<Layout title={pageTitle} description={pageDescription}>
  {isUnavailable ? (
    <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-24 text-center">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-50 text-amber-600">
        <AlertCircle className="h-8 w-8" client:load />
      </div>
      <h1 class="text-2xl font-extrabold text-gray-900">Service Temporarily Unavailable</h1>
      <p class="mt-2 text-[14px] text-gray-500 max-w-md mx-auto">
        We encountered a temporary connection issue while loading this listing. Please retry in a few moments.
      </p>
      <div class="mt-7 flex items-center justify-center gap-3">
        <button
          onclick="window.location.reload()"
          class="inline-flex items-center gap-2 rounded-full bg-[#352778] px-6 py-2.5 text-[13px] font-bold text-white hover:bg-[#2a1f5e] transition-colors"
        >
          <RefreshCw className="h-4 w-4" client:load />
          Retry Now
        </button>
        <a
          href="/products"
          class="inline-flex items-center rounded-full border border-gray-200 px-6 py-2.5 text-[13px] font-semibold text-gray-700 hover:border-gray-300 hover:bg-gray-50 transition-colors"
        >
          Browse All Listings
        </a>
      </div>
    </div>
  ) : !product ? (
    <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-24 text-center">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-purple-50 text-[#352778]">
        <PackageX className="h-8 w-8" client:load />
      </div>
      <h1 class="text-2xl font-extrabold text-gray-900">Listing Not Found</h1>
      <p class="mt-2 text-[14px] text-gray-500 max-w-md mx-auto">
        This listing does not exist, has expired, or was removed by the merchant.
      </p>
      <div class="mt-7 flex items-center justify-center gap-3">
        <a
          href="/products"
          class="inline-flex items-center gap-2 rounded-full bg-[#352778] px-6 py-2.5 text-[13px] font-bold text-white hover:bg-[#2a1f5e] transition-colors"
        >
          Browse All Products
        </a>
        <a
          href="/"
          class="inline-flex items-center rounded-full border border-gray-200 px-6 py-2.5 text-[13px] font-semibold text-gray-700 hover:border-gray-300 hover:bg-gray-50 transition-colors"
        >
          Return Home
        </a>
      </div>
    </div>
  ) : (
    <div>
      <nav class="border-b border-gray-200 bg-gray-50/60">
        <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-3 flex items-center gap-1.5 text-[12px] text-gray-400 overflow-x-auto whitespace-nowrap">
          <a href="/" class="hover:text-gray-700 transition-colors">Home</a>
          <ChevronRight className="h-3 w-3 shrink-0" />
          <a href="/products" class="hover:text-gray-700 transition-colors">Products</a>
          <ChevronRight className="h-3 w-3 shrink-0" />
          <a href={`/products?category=${product.category}`} class="hover:text-gray-700 transition-colors">{categoryLabel}</a>
          <ChevronRight className="h-3 w-3 shrink-0" />
          <span class="truncate font-semibold text-gray-700 max-w-[220px] sm:max-w-md">{product.name}</span>
        </div>
      </nav>

      <div class="mx-auto max-w-[1152px] px-5 sm:px-8 py-9 sm:py-12 pb-28 md:pb-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-10 items-start">

          <div class="lg:col-span-7 space-y-6">
            <ProductGallery
              images={product.images || []}
              productName={product.name}
              categoryLabel={categoryLabel}
              client:load
            />

            <div class="rounded-2xl border border-gray-200 bg-white p-6">
              <h2 class="text-[15px] font-extrabold text-gray-900 mb-3.5 border-l-[3px] border-[#352778] pl-3">
                Description
              </h2>
              <div class="text-[13.5px] leading-relaxed text-gray-600 whitespace-pre-line">
                {product.description}
              </div>
            </div>

            {product.attributes && Object.keys(product.attributes).length > 0 && (
              <div class="rounded-2xl border border-gray-200 bg-white p-6">
                <h2 class="text-[15px] font-extrabold text-gray-900 mb-3.5 border-l-[3px] border-[#352778] pl-3">
                  Specifications
                </h2>
                <div class="overflow-hidden rounded-xl border border-gray-100">
                  {Object.entries(product.attributes).map(([key, value], i) => (
                    <div class={`flex items-center justify-between px-4 py-2.5 text-[13px] ${i % 2 === 0 ? 'bg-gray-50/60' : 'bg-white'}`}>
                      <span class="font-medium text-gray-500">{formatAttributeKey(key)}</span>
                      <span class="font-semibold text-gray-900 text-right">{formatAttributeValue(value)}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-[80px]">

            <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-[0_2px_12px_0_rgba(53,39,120,0.07)]">

              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="inline-flex items-center rounded-full border border-purple-200 bg-purple-50 px-2.5 py-0.5 text-[11.5px] font-bold text-[#352778]">
                  {categoryLabel}
                </span>
                {product.productType === 'service' ? (
                  <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[11.5px] font-bold text-blue-700">Professional Service</span>
                ) : isOutOfStock ? (
                  <span class="rounded-full border border-red-200 bg-red-50 px-2.5 py-0.5 text-[11.5px] font-bold text-red-700">Out of Stock</span>
                ) : isLowStock ? (
                  <span class="rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-[11.5px] font-bold text-amber-800">Only {product.stockQuantity} left</span>
                ) : (
                  <span class="rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[11.5px] font-bold text-emerald-700">In Stock</span>
                )}
              </div>

              <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-gray-900 leading-snug">
                {product.name}
              </h1>

              <div class="mt-4 flex items-baseline gap-3">
                <span class="text-[1.85rem] font-extrabold tracking-tight text-[#352778]" style="font-family:'Montserrat',sans-serif;">
                  {formattedPrice}
                </span>
                {hasDiscount && (
                  <div class="flex items-center gap-2">
                    <span class="text-[15px] text-gray-400 line-through">{formattedCompareAtPrice}</span>
                    <span class="rounded-full px-2.5 py-0.5 text-[11.5px] font-bold text-white" style="background-color:#E85918;">
                      {discountPercent}% OFF
                    </span>
                  </div>
                )}
              </div>

              <div class="mt-6 space-y-2.5">
                {whatsappUrl && (
                  <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="block w-full">
                    <button class="w-full inline-flex items-center justify-center gap-2 rounded-full bg-emerald-600 hover:bg-emerald-700 py-3.5 text-[14px] font-bold text-white shadow-sm hover:shadow-md hover:-translate-y-px transition-all active:scale-[0.98]">
                      <MessageCircle className="h-5 w-5" />
                      Chat on WhatsApp
                    </button>
                  </a>
                )}
                {telUrl && (
                  <a href={telUrl} id="call-seller-btn" class="block w-full">
                    <button class="w-full inline-flex items-center justify-center gap-2 rounded-full border-2 border-gray-200 py-3 text-[14px] font-bold text-gray-700 hover:border-[#352778] hover:text-[#352778] transition-all">
                      <Phone className="h-4 w-4" />
                      Call Seller ({rawPhone})
                    </button>
                  </a>
                )}
                {product.purchaseUrl && (
                  <a href={product.purchaseUrl} target="_blank" rel="noopener noreferrer" class="block w-full">
                    <button class="w-full inline-flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-gray-50 hover:bg-gray-100 py-3 text-[13.5px] font-bold text-gray-700 transition-all">
                      <ExternalLink className="h-4 w-4" />
                      Order on Seller's Store
                    </button>
                  </a>
                )}
                <button
                  id="share-btn"
                  type="button"
                  class="w-full inline-flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-white py-2.5 text-[13px] font-bold text-gray-600 hover:border-[#7c3aed] hover:text-[#352778] hover:bg-purple-50/30 transition-all cursor-pointer"
                >
                  <Share2 className="h-4 w-4" />
                  <span id="share-btn-text">Share listing</span>
                </button>
              </div>
            </div>

            <div id="product-detail-analytics" data-product-id={product.id} data-api-url={API_BASE_URL} class="hidden"></div>
            <script is:inline>
              (function () {
                var el = document.getElementById('product-detail-analytics');
                if (!el) return;
                var productId = el.getAttribute('data-product-id');
                var apiBase = el.getAttribute('data-api-url') || 'http://localhost:3000';
                if (!productId) return;

                var eventsUrl = apiBase + '/api/v1/marketplace/products/' + encodeURIComponent(productId) + '/events';

                function sendBeaconEvent(type, source) {
                  try {
                    var payload = JSON.stringify({ type: type, source: source });
                    if (typeof fetch !== 'undefined') {
                      fetch(eventsUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: payload,
                        keepalive: true,
                      }).catch(function () {});
                    } else if (typeof navigator !== 'undefined' && navigator.sendBeacon) {
                      var blob = new Blob([payload], { type: 'application/json' });
                      navigator.sendBeacon(eventsUrl, blob);
                    }
                  } catch (e) {}
                }

                // 1. Immediately record public view of this product on page mount
                sendBeaconEvent('view', 'detail_page');

                // 2. Track call clicks
                var callBtn = document.getElementById('call-seller-btn');
                if (callBtn) {
                  callBtn.addEventListener('click', function () {
                    sendBeaconEvent('call_click', 'detail_page');
                  });
                }

                // 3. Track share clicks & clipboard copy
                var shareBtn = document.getElementById('share-btn');
                var shareText = document.getElementById('share-btn-text');
                if (shareBtn && shareText) {
                  shareBtn.addEventListener('click', async function () {
                    sendBeaconEvent('share_click', 'detail_page');
                    var url = window.location.href;
                    var title = document.title;
                    if (navigator.share) {
                      try {
                        await navigator.share({ title: title, url: url });
                        return;
                      } catch (err) {}
                    }
                    if (navigator.clipboard) {
                      try {
                        await navigator.clipboard.writeText(url);
                        var original = shareText.textContent;
                        shareText.textContent = 'Link copied to clipboard!';
                        shareBtn.classList.add('border-emerald-500', 'text-emerald-700', 'bg-emerald-50/50');
                        setTimeout(function () {
                          shareText.textContent = original;
                          shareBtn.classList.remove('border-emerald-500', 'text-emerald-700', 'bg-emerald-50/50');
                        }, 2500);
                      } catch (err) {}
                    }
                  });
                }
              })();
            </script>

            <div class="rounded-2xl border border-gray-200 bg-white p-5">
              <div class="flex items-center gap-3.5">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#352778] to-[#7c3aed] text-white text-[15px] font-extrabold ring-2 ring-purple-100">
                  {sellerInitial}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-1.5">
                    {storefrontUrl ? (
                      <a href={storefrontUrl} class="text-[14px] font-bold text-gray-900 hover:text-[#352778] transition-colors truncate">
                        {product.seller?.businessName || 'Verified Merchant'}
                      </a>
                    ) : (
                      <span class="text-[14px] font-bold text-gray-900 truncate">
                        {product.seller?.businessName || 'Verified Merchant'}
                      </span>
                    )}
                    {product.seller?.isVerified && (
                      <span title="Verified Business">
                        <BadgeCheck className="h-4 w-4 shrink-0 text-[#7c3aed]" />
                      </span>
                    )}
                  </div>
                  <p class="text-[12px] text-gray-400 mt-0.5">WallX Registered Business</p>
                </div>
              </div>
              {(product.seller?.city || product.seller?.state) && (
                <div class="mt-3 flex items-center gap-1.5 text-[12px] text-gray-400 pt-3 border-t border-gray-100">
                  <MapPin className="h-3.5 w-3.5 text-[#7c3aed] shrink-0" />
                  <span>{[product.seller.city, product.seller.state].filter(Boolean).join(', ')}</span>
                </div>
              )}
              {storefrontUrl && (
                <div class="mt-3 pt-3 border-t border-gray-100">
                  <a
                    href={storefrontUrl}
                    class="inline-flex items-center gap-1.5 text-[12.5px] font-bold text-[#352778] hover:text-[#7c3aed] transition-colors"
                  >
                    <span>View Seller Storefront</span>
                    <ArrowRight className="h-3.5 w-3.5" />
                  </a>
                </div>
              )}
            </div>

            <div class="rounded-2xl border border-amber-200/80 bg-amber-50 p-5">
              <div class="flex items-center gap-2 mb-3">
                <ShieldCheck className="h-4.5 w-4.5 text-amber-600 shrink-0" />
                <span class="text-[12.5px] font-bold text-amber-900">Buyer Protection Tips</span>
              </div>
              <ul class="space-y-1.5 text-[12px] text-amber-800 list-disc list-inside">
                <li>Meet seller in a busy, public commercial location.</li>
                <li>Inspect item thoroughly before releasing payment.</li>
                <li>Do not transfer funds upfront or pay to unlock listings.</li>
              </ul>
            </div>

          </div>
        </div>

        {relatedProducts && relatedProducts.length > 0 && (
          <div class="mt-16 border-t border-gray-200 pt-12">
            <div class="mb-7">
              <h2 class="text-xl font-extrabold tracking-tight text-gray-900 border-l-[3px] border-[#352778] pl-4">
                More from {product.seller?.businessName || 'this Merchant'}
              </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
              {relatedProducts.map((rel) => (
                <ProductCard
                  product={{
                    ...rel,
                    description: '',
                    trackInventory: false,
                    attributes: {},
                    seller: product.seller,
                    createdAt: new Date().toISOString(),
                  }}
                  client:load
                />
              ))}
            </div>
          </div>
        )}
      </div>

      <MobileStickyContact
        productId={product.id}
        whatsappUrl={mobileStickyWhatsappUrl}
        callUrl={telUrl}
        price={formattedPrice}
        client:load
      />
    </div>
  )}
</Layout>
